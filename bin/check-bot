#!/usr/bin/env python3
"""Dev-only: prove Ariane only enters a room she was invited to.

Run with `make check-bot` after `make provision-bot`.

This is the acceptance test of the consent rule. It creates a throwaway private
room as a human, then checks three things in order:

  1. she cannot join on her own          -> M_FORBIDDEN, and that is the point;
  2. an invitation lets her in           -> the only door there is;
  3. she can then post as herself        -> masquerading through the AS token.

Step 1 failing to fail would mean the room is not private, and the rest proves
nothing. So it is asserted, not skipped.

An earlier version proved the opposite: that a Synapse admin token could walk
her into any room. That token is gone, and so is that test.
"""

from __future__ import annotations

import json
import pathlib
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

HOMESERVER = "http://localhost:9808"
ENV_FILE = pathlib.Path("env.d/development/bots.local")

MAS_CONTAINER = "hub-mas-1"
MAS_CONFIG = "/config/config.yaml"
HUMAN = "hub"

OK = "  \033[32mOK\033[0m  "
KO = "  \033[31mKO\033[0m  "


def fail(message: str) -> None:
    print(f"check-bot: {message}", file=sys.stderr)
    sys.exit(1)


def read_env() -> dict[str, str]:
    if not ENV_FILE.is_file():
        fail(f"{ENV_FILE} missing. Run `make provision-bot` first.")
    values = {}
    for line in ENV_FILE.read_text().splitlines():
        if line and not line.startswith("#") and "=" in line:
            key, _, value = line.partition("=")
            values[key] = value
    return values


def call(method: str, path: str, token: str, body: dict | None = None) -> dict:
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(HOMESERVER + path, data=data, method=method)
    request.add_header("Authorization", f"Bearer {token:s}")
    if data:
        request.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(request) as response:
            return json.loads(response.read() or b"{}")
    except urllib.error.HTTPError as error:
        payload = json.loads(error.read() or b"{}")
        payload["_status"] = error.code
        return payload
    except urllib.error.URLError as error:
        fail(f"{HOMESERVER} unreachable ({error.reason}).")


def quote(value: str) -> str:
    return urllib.parse.quote(value, safe="")


def human_token() -> str:
    """A throwaway token for the human who owns the test room."""
    issued = subprocess.run(
        ["docker", "exec", MAS_CONTAINER, "mas-cli", "manage", "--config", MAS_CONFIG,
         "issue-compatibility-token", HUMAN],
        capture_output=True, text=True, check=False,
    )
    for word in (issued.stdout + issued.stderr).split():
        if word.startswith("mct_"):
            return word
    fail(f"could not issue a token for @{HUMAN}: {issued.stderr.strip()}")


HEALTH_URL = "http://localhost:9801/bots/health/"
ANSWER_TIMEOUT_S = 25


def service_up() -> bool:
    try:
        with urllib.request.urlopen(HEALTH_URL, timeout=3) as response:
            return b"ok" in response.read()
    except (urllib.error.URLError, OSError):
        return False


def check_mention_after_invite(owner: str, bot: str, as_token: str) -> int:
    """Invite her and mention her in the same breath, as the Hub does."""
    room = call("POST", "/_matrix/client/v3/createRoom", owner,
                {"name": "check-bot mention (jetable)", "preset": "private_chat"})
    if "room_id" not in room:
        print(f"{KO}salon de la 4e verification impossible: {room}")
        return 1
    room_id = room["room_id"]
    failures = 0
    try:
        call("POST", f"/_matrix/client/v3/rooms/{quote(room_id)}/invite", owner, {"user_id": bot})
        txn = f"checkbot-mention{int(time.time() * 1000)}"
        sent = call("PUT",
                    f"/_matrix/client/v3/rooms/{quote(room_id)}/send/m.room.message/{txn}",
                    owner, {"msgtype": "m.text", "body": "@Ariane /aide"})
        if "event_id" not in sent:
            print(f"{KO}mention refusee: {sent}")
            return 1
        deadline = time.time() + ANSWER_TIMEOUT_S
        answered = None
        while time.time() < deadline and answered is None:
            time.sleep(1)
            page = call("GET", f"/_matrix/client/v3/rooms/{quote(room_id)}/messages?dir=b&limit=20", owner)
            for event in page.get("chunk", []):
                if event.get("sender") == bot and event.get("type") == "m.room.message":
                    answered = event
                    break
        if answered:
            print(f"{OK}invitee et mentionnee dans la foulee, elle repond ({answered['event_id'][:24]}...)")
        else:
            print(f"{KO}invitee et mentionnee, pas de reponse en {ANSWER_TIMEOUT_S} s")
            failures += 1
    finally:
        call("POST", f"/_matrix/client/v3/rooms/{quote(room_id)}/leave?user_id={quote(bot)}", as_token, {})
        call("POST", f"/_matrix/client/v3/rooms/{quote(room_id)}/leave", owner, {})
        call("POST", f"/_matrix/client/v3/rooms/{quote(room_id)}/forget", owner, {})
    return failures


def main() -> None:
    env = read_env()
    bot = env["MATRIX_BOT_USER_ID"]
    as_token = env["MATRIX_AS_TOKEN"]
    failures = 0

    print("check-bot")
    owner = human_token()

    room = call("POST", "/_matrix/client/v3/createRoom", owner,
                {"name": "check-bot (jetable)", "preset": "private_chat"})
    if "room_id" not in room:
        fail(f"could not create the test room: {room}")
    room_id = room["room_id"]
    print(f"  salon prive {room_id}")

    # 1. She must not be able to walk in. If she can, the room is not private
    #    and everything below proves nothing.
    walked_in = call("POST", f"/_matrix/client/v3/join/{quote(room_id)}?user_id={quote(bot)}", as_token, {})
    if walked_in.get("errcode") == "M_FORBIDDEN":
        print(f"{OK}sans invitation, l'entree est refusee (M_FORBIDDEN)")
    else:
        print(f"{KO}elle est entree sans invitation: {walked_in}")
        failures += 1

    # 2. The invitation is the only door.
    call("POST", f"/_matrix/client/v3/rooms/{quote(room_id)}/invite", owner, {"user_id": bot})
    joined = call("POST", f"/_matrix/client/v3/join/{quote(room_id)}?user_id={quote(bot)}", as_token, {})
    if joined.get("room_id") == room_id:
        print(f"{OK}l'invitation la fait entrer")
    else:
        print(f"{KO}invitee, elle n'a pas pu entrer: {joined}")
        failures += 1

    # 3. And she speaks as herself, not as the service account.
    txn = f"checkbot{int(time.time() * 1000)}"
    sent = call("PUT",
                f"/_matrix/client/v3/rooms/{quote(room_id)}/send/m.room.message/{txn}?user_id={quote(bot)}",
                as_token, {"msgtype": "m.text", "body": "Ariane presente."})
    if "event_id" in sent:
        print(f"{OK}elle poste dans le salon ({sent['event_id'][:24]}...)")
    else:
        print(f"{KO}envoi refuse: {sent}")
        failures += 1

    # Clean up: a throwaway room should not outlive the test.
    call("POST", f"/_matrix/client/v3/rooms/{quote(room_id)}/leave?user_id={quote(bot)}", as_token, {})
    call("POST", f"/_matrix/client/v3/rooms/{quote(room_id)}/leave", owner, {})
    call("POST", f"/_matrix/client/v3/rooms/{quote(room_id)}/forget", owner, {})

    # 4. Mentioning her is how she gets in: the Hub invites her and sends the
    #    message right behind. She must accept, read it and answer - which
    #    needs the assistant service itself, not just the homeserver.
    if not service_up():
        print(f"  --  service absent ({HEALTH_URL}): la 4e verification est sautee")
    else:
        failures += check_mention_after_invite(owner, bot, as_token)
    print("  salon jetable quitte et oublie")

    if failures:
        print(f"\n{failures} verification(s) en echec.")
        sys.exit(1)
    print("\ntoutes les verifications passent.")


if __name__ == "__main__":
    main()
