#!/usr/bin/env python3
"""Dev-only: prove the assistant can reach a private room it was never invited to.

Run with `make check-bot` after `make provision-bot`.

This is the acceptance test of the omnipresence design. It creates a throwaway
private room as a human, then checks three things in order:

  1. the bot CANNOT join on its own       -> M_FORBIDDEN, and that is correct;
  2. the admin token lets it in           -> this is what "everywhere" costs;
  3. it can then post as itself           -> masquerading through the AS token.

Step 1 failing to fail would mean the room is not private, and the test proves
nothing. So it is asserted, not skipped.
"""

from __future__ import annotations

import json
import os
import pathlib
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

HOMESERVER = "http://localhost:9808"
ENV_FILE = pathlib.Path("env.d/development/bots.local")

MAS_CONTAINER = "hub-mas-1"
MAS_CONFIG = "/config/config.yaml"
HUMAN = "hub"

OK = "  \033[32mOK\033[0m  "
KO = "  \033[31mKO\033[0m  "


def fail(message: str) -> None:
    print(f"check-bot: {message}", file=sys.stderr)
    sys.exit(1)


def read_env() -> dict[str, str]:
    if not ENV_FILE.is_file():
        fail(f"{ENV_FILE} missing. Run `make provision-bot` first.")
    values = {}
    for line in ENV_FILE.read_text().splitlines():
        if line and not line.startswith("#") and "=" in line:
            key, _, value = line.partition("=")
            values[key] = value
    return values


def call(method: str, path: str, token: str, body: dict | None = None) -> dict:
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(HOMESERVER + path, data=data, method=method)
    request.add_header("Authorization", f"Bearer {token}")
    if data:
        request.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(request) as response:
            return json.loads(response.read() or b"{}")
    except urllib.error.HTTPError as error:
        payload = json.loads(error.read() or b"{}")
        payload["_status"] = error.code
        return payload
    except urllib.error.URLError as error:
        fail(f"{HOMESERVER} unreachable ({error.reason}).")


def quote(value: str) -> str:
    return urllib.parse.quote(value, safe="")


def human_token() -> str:
    """A throwaway token for the human who owns the test room."""
    issued = subprocess.run(
        ["docker", "exec", MAS_CONTAINER, "mas-cli", "manage", "--config", MAS_CONFIG,
         "issue-compatibility-token", HUMAN],
        capture_output=True, text=True, check=False,
    )
    for word in (issued.stdout + issued.stderr).split():
        if word.startswith("mct_"):
            return word
    fail(f"could not issue a token for @{HUMAN}: {issued.stderr.strip()}")


def main() -> None:
    env = read_env()
    bot = env["MATRIX_BOT_USER_ID"]
    as_token = env["MATRIX_AS_TOKEN"]
    admin_token = env["MATRIX_ADMIN_TOKEN"]
    failures = 0

    print("check-bot")
    owner = human_token()

    room = call("POST", "/_matrix/client/v3/createRoom", owner,
                {"name": "check-bot (jetable)", "preset": "private_chat"})
    if "room_id" not in room:
        fail(f"could not create the test room: {room}")
    room_id = room["room_id"]
    print(f"  salon prive {room_id}")

    # 1. The bot must NOT be able to walk in. If it can, the room is not private
    #    and everything below proves nothing.
    walked_in = call("POST", f"/_matrix/client/v3/join/{quote(room_id)}?user_id={quote(bot)}", as_token, {})
    if walked_in.get("errcode") == "M_FORBIDDEN":
        print(f"{OK}sans invitation, l'entree est refusee (M_FORBIDDEN)")
    else:
        print(f"{KO}le bot est entre sans jeton d'admin: {walked_in}")
        failures += 1

    # 2. The admin token is the door.
    forced = call("POST", f"/_synapse/admin/v1/join/{quote(room_id)}", admin_token, {"user_id": bot})
    if forced.get("room_id") == room_id:
        print(f"{OK}le jeton d'admin le fait entrer")
    else:
        print(f"{KO}force-join refuse: {forced}")
        failures += 1

    # 3. And it speaks as itself, not as the service account.
    txn = f"checkbot{int(time.time() * 1000)}"
    sent = call("PUT",
                f"/_matrix/client/v3/rooms/{quote(room_id)}/send/m.room.message/{txn}?user_id={quote(bot)}",
                as_token, {"msgtype": "m.text", "body": "Assistant present."})
    if "event_id" in sent:
        print(f"{OK}il poste dans le salon ({sent['event_id'][:24]}...)")
    else:
        print(f"{KO}envoi refuse: {sent}")
        failures += 1

    # Clean up: a throwaway room should not outlive the test.
    call("POST", f"/_matrix/client/v3/rooms/{quote(room_id)}/leave?user_id={quote(bot)}", as_token, {})
    call("POST", f"/_matrix/client/v3/rooms/{quote(room_id)}/leave", owner, {})
    call("POST", f"/_matrix/client/v3/rooms/{quote(room_id)}/forget", owner, {})
    print("  salon jetable quitte et oublie")

    if failures:
        print(f"\n{failures} verification(s) en echec.")
        sys.exit(1)
    print("\nles 3 verifications passent.")


if __name__ == "__main__":
    main()
